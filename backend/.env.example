# ══════════════════════════════════════════════════════════════════════════════
#  Kronos — Previta S.A. de C.V.
#  Configuración del servidor backend
#
#  Copia este archivo a .env y completa los valores antes de iniciar.
#  NUNCA subas el archivo .env al repositorio.
# ══════════════════════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=https://kronos.previta.com.mx

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_64_CARACTERES_MINIMO

# ── Base de datos principal (previta_kronos en AWS RDS) ───────────────────────
DB_ENABLED=true
DB_HOST=athenasys-db.chioa482k7r3.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=previta_kronos
DB_USER=admin
DB_PASSWORD=TU_PASSWORD_RDS_AQUI
DB_CONNECTION_LIMIT=20

# ── Base de datos Athenasys (cross-DB, mismo servidor RDS) ────────────────────
# Se usa para consultas en vivo de empleados y sucursales de Athenasys.
# Debe ser el nombre exacto de la BD en el RDS (usualmente "athenasys").
ATHENASYS_DB_NAME=athenasys

# ── Correo (restablecimiento de contraseña) ───────────────────────────────────
# En desarrollo: dejar vacío → se usa Ethereal (correos de prueba, URL en consola)
# En producción: configurar con SMTP real (Office 365, SendGrid, etc.)
APP_URL=https://kronos.previta.com.mx
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kronos@previta.com.mx
SMTP_PASS=TU_PASSWORD_SMTP_AQUI
SMTP_FROM=Kronos Previta <kronos@previta.com.mx>
